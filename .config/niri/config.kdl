// niri config — Gintama Dark
//
// Ported from the Hyprland Lua config in ~/dotfiles/.config/hypr/
// (hyprland.lua, keys.lua, monitors.lua, programs.lua).
//
// Design goals:
//   - Hyprland muscle memory preserved: ALT as mod, vim h/j/k/l, same launchers.
//   - Use niri as intended: scrolling columns, named workspaces, Overview.
//   - Visuals match the current Hyprland setup exactly: no gaps, 2px border,
//     no shadows, no blur, no animations, fully opaque.
//
// Palette (Gintama Dark, dark Yorozuya):
//   base    #141A22   surface #1B222C   raised  #252E3A
//   border  #474F53   muted   #68647C
//   fg      #EBEEE8   fg dim  #C9E0EF
//   accent  #7C91BF   bright  #9BC1FF
//   ginshu  #BC2D29   (銀朱 — urgent only)
//   brass   #baa451   (official 20th-anniv gold — warnings only)
//
// Validate before loading:  niri validate -c ~/.config/niri/config.kdl

input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        // hyprland.lua: touchpad.scroll_factor = 0.6
        scroll-factor 0.6
    }

    mouse {
        // hyprland.lua: accel_profile = "flat", sensitivity = 0
        accel-profile "flat"
    }

    trackpoint {
    }

    // hyprland.lua: follow_mouse = 1
    focus-follows-mouse

    // Hyprland used ALT as $mainMod. Keeping it so muscle memory survives.
    // Note: niri cannot swap bind sets at runtime, so the Lost Ark ALT<->SUPER
    // hack from keys.lua has no equivalent here. Accepted deliberately.
    mod-key "Alt"
}

// Identical monitors with blank serials, so match by connector name only.
//
// NOTE the refresh rate: these panels advertise 1920x1080@143.998, and niri
// requires an exact match. "1920x1080@144" silently fails to match and falls
// back to the preferred mode, which is 60Hz. Verify with `niri msg outputs`.
output "DP-1" {
    mode "1920x1080@143.998"
    scale 1
    transform "normal"
    position x=0 y=0
    background-color "#141A22"
    // DP-1 reports "Variable refresh rate: not supported". niri also has no
    // tearing support, so the CS2 `immediate`/allow_tearing rule has no
    // replacement on this output at all. Left declared in case that changes.
    variable-refresh-rate on-demand=true
}

output "HDMI-A-1" {
    mode "1920x1080@143.998"
    scale 1
    transform "normal"
    position x=1920 y=0
    background-color "#141A22"
    // This one does support VRR. On-demand = only while a window matching the
    // variable-refresh-rate window rule is on this output.
    variable-refresh-rate on-demand=true
}

// Named workspaces persist when empty and pin to an output, which is what
// makes Alt+1..4 stable. Anything past these is dynamic.
// Mirrors the Hyprland pinning: 1,2,4 -> DP-1 and 3 -> HDMI-A-1.
workspace "main" {
    open-on-output "DP-1"
}
workspace "web" {
    open-on-output "DP-1"
}
workspace "chat" {
    open-on-output "HDMI-A-1"
}
workspace "dev" {
    open-on-output "DP-1"
}

layout {
    // hyprland.lua: gaps_in = 0, gaps_out = 0
    gaps 0

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // Full-width columns by default; Alt+R cycles 33/50/66%.
    default-column-width { proportion 1.0; }

    // focus-ring and border are redundant — border is the one that matches
    // Hyprland's look, so focus-ring is off.
    focus-ring {
        off
    }

    border {
        on
        // hyprland.lua: border_size = 2
        width 2
        active-color "#7C91BF"    // kimono steel   (was #7aa2f7)
        inactive-color "#474F53"  // Gintoki steel  (was #595959aa)
        urgent-color "#BC2D29"    // 銀朱 ginshu
    }

    // hyprland.lua: decoration.shadow.enabled = false
    shadow {
        off
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        gap 4
        width 3
        position "left"
        active-color "#7C91BF"
        inactive-color "#474F53"
        urgent-color "#BC2D29"
    }

    insert-hint {
        color "#7C91BF80"
    }

    struts {
    }

    background-color "#141A22"
}

overview {
    backdrop-color "#0F141B"
}

// hyprland.lua: animations.enabled = false
animations {
    off
}

// Borders draw behind windows by default, which shows through semitransparent
// ones (kitty runs at 0.95 opacity). prefer-no-csd fixes that.
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

gestures {
    // Easy to hit by accident when reaching for the bar.
    hot-corners {
        off
    }
}

environment {
    XCURSOR_SIZE "24"
    // AMD RX 9060 XT (RADV). HYPRCURSOR_SIZE is Hyprland-only, dropped.
    LIBVA_DRIVER_NAME "radeonsi"
    LIBVA_DRIVERS_PATH "/usr/lib/dri"
    VDPAU_DRIVER "radeonsi"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"

    // Phase 2 — session-local theme isolation, so Hyprland keeps Tokyo Night.
    // Commented until the targets exist; pointing at a missing kitty config dir
    // or a missing GTK theme is worse than leaving the defaults alone.
    // KITTY_CONFIG_DIRECTORY "/home/sleuth/.config/kitty-gintama"
    // GTK_THEME "Gintama-Dark"
}

// Ported from hyprland.lua's exec-once list.
// Dropped: `xrandr --output DP-1 --primary` (X11-only, meaningless here) and
// `systemctl --user start hyprland-session.target` (niri-session pulls
// graphical-session.target natively — that target was a Hyprland-specific fix).
spawn-at-startup "nm-applet"
spawn-at-startup "fcitx5"
spawn-at-startup "blueman-applet"
spawn-at-startup "vesktop"
spawn-at-startup "ssh-agent" "-D" "-a" "/run/user/1000/ssh-agent.socket"

// DankMaterialShell: bar, notifications, launcher, lock, OSDs.
//
// Deliberately spawn-at-startup rather than `systemctl --user enable dms.service`.
// That unit is WantedBy=graphical-session.target, and Hyprland now activates
// that target too (via hyprland-session.target, the screenshare fix), so
// enabling it would start DMS on Hyprland as well and fight waybar there.
// Spawning it here keeps DMS strictly niri-only.
//
// DMS owns org.freedesktop.Notifications, so swaync must NOT also run here.
spawn-at-startup "dms" "run"

// Do NOT add xwayland-satellite here. niri 26.04 creates the X11 sockets,
// exports $DISPLAY and lazy-spawns it on first X11 client connection. A manual
// spawn-at-startup or DISPLAY env var actively breaks that integration.

/////////////////////
// Window rules
/////////////////////

// Discord -> the chat workspace on HDMI-A-1, without stealing focus.
// (Hyprland: `workspace = "3 silent"`)
window-rule {
    match app-id=r#"^vesktop$"#
    open-on-workspace "chat"
    open-focused false
}

// Godot editor dialogs: float, on the dev workspace.
window-rule {
    match app-id=r#"^org\.godotengine\.Editor$"# title=r#"^Project Settings"#
    match app-id=r#"^org\.godotengine\.Editor$"# title=r#"^Editor Settings"#
    match app-id=r#"^org\.godotengine\.Editor$"# title=r#"^Create New Node$"#
    open-on-workspace "dev"
    open-floating true
}

window-rule {
    match app-id=r#"^org\.godotengine\.Editor$"# title=r#"^Godot$"#
    match app-id=r#"^org\.godotengine\.ProjectManager$"#
    open-on-workspace "dev"
    open-floating true
}

// Godot debug/run window — floats, stays on the current workspace.
window-rule {
    match app-id=r#"^Godot "#
    open-floating true
}

// Manga reader: no decoration at all.
window-rule {
    match app-id=r#"^[Mm]angayomi$"#
    border {
        off
    }
    focus-ring {
        off
    }
}

// Games: enable VRR on the output while they're visible. This is the closest
// thing niri has to Hyprland's `immediate`/allow_tearing, which it cannot do.
window-rule {
    match app-id=r#"^steam_app_"#
    match title=r#"^Counter-Strike 2$"#
    variable-refresh-rate true
}

// Unreal Editor — Hyprland disabled blur/shadow/anim for it, all of which are
// already off globally here, so only VRR is worth pinning.
window-rule {
    match app-id=r#"^(UnrealEditor|UE4Editor|UE5Editor)$"#
    variable-refresh-rate true
}

// Picture-in-picture floats (niri stock rule, kept).
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

/////////////////////
// Binds
/////////////////////
// Mod = ALT (see input.mod-key above).

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    //--- launchers -------------------------------------------------------
    Mod+Return hotkey-overlay-title="Terminal: kitty" { spawn "kitty"; }
    Mod+E      hotkey-overlay-title="Files: dolphin"  { spawn "dolphin"; }
    Mod+D      hotkey-overlay-title="Launcher"        { spawn "dms" "ipc" "call" "spotlight" "toggle"; }

    //--- DankMaterialShell -----------------------------------------------
    // Super+L matches the Hyprland lock bind exactly.
    Super+L    hotkey-overlay-title="Lock the Screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+N      hotkey-overlay-title="Notifications"   { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+P      hotkey-overlay-title="Power Menu"      { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+S      hotkey-overlay-title="Settings"        { spawn "dms" "ipc" "call" "settings" "toggle"; }
    Mod+Shift+V hotkey-overlay-title="Clipboard"      { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+Slash  hotkey-overlay-title="Keybind Cheatsheet" { spawn "dms" "ipc" "call" "keybinds" "toggle"; }

    //--- window ----------------------------------------------------------
    Mod+Shift+Q repeat=false { close-window; }
    Mod+V { toggle-window-floating; }
    Mod+W { switch-focus-between-floating-and-tiling; }
    Mod+F { fullscreen-window; }
    Mod+Shift+F { maximize-column; }
    // Closest analogue to dwindle's togglesplit.
    Mod+T { toggle-column-tabbed-display; }
    // Hyprland bound Mod+M to `exit`. Kept for parity — niri confirms first.
    Mod+M { quit; }

    //--- focus (vim + arrows) --------------------------------------------
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    //--- move window/column ----------------------------------------------
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    //--- monitors (Hyprland had no binds for this at all) ----------------
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

    //--- workspaces ------------------------------------------------------
    // 1-4 are the named, output-pinned ones. Reference them BY NAME: on a
    // dynamic system `focus-workspace 9` lands on the bottommost workspace,
    // not workspace 9.
    Mod+1 { focus-workspace "main"; }
    Mod+2 { focus-workspace "web"; }
    Mod+3 { focus-workspace "chat"; }
    Mod+4 { focus-workspace "dev"; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    // Hyprland used movetoworkspacesilent — focus does not follow.
    Mod+Shift+1 { move-window-to-workspace "main" focus=false; }
    Mod+Shift+2 { move-window-to-workspace "web" focus=false; }
    Mod+Shift+3 { move-window-to-workspace "chat" focus=false; }
    Mod+Shift+4 { move-window-to-workspace "dev" focus=false; }
    Mod+Shift+5 { move-window-to-workspace 5 focus=false; }
    Mod+Shift+6 { move-window-to-workspace 6 focus=false; }
    Mod+Shift+7 { move-window-to-workspace 7 focus=false; }
    Mod+Shift+8 { move-window-to-workspace 8 focus=false; }
    Mod+Shift+9 { move-window-to-workspace 9 focus=false; }
    Mod+Shift+0 { move-window-to-workspace 10 focus=false; }

    Mod+Tab { focus-workspace-previous; }

    // niri-native vertical workspace movement.
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }

    // hyprland.lua: mod+scroll cycles workspaces
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    //--- overview (no Hyprland equivalent) -------------------------------
    Mod+O repeat=false { toggle-overview; }

    //--- column sizing ---------------------------------------------------
    // Fills a real gap: today there is no keyboard resize at all, only
    // Alt+RMB drag.
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+C { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    //--- screenshots -----------------------------------------------------
    // niri's built-in screenshot UI replaces the grim+slurp binds.
    // (The old Ctrl+Shift+Print bind called grimblast, which was never
    // installed — it has been broken this whole time.)
    Print { screenshot; }
    Shift+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    //--- screencast target (relevant for Jitsi) --------------------------
    Mod+Shift+C { set-dynamic-cast-window; }
    Mod+Shift+M { set-dynamic-cast-monitor; }
    Mod+Shift+X { clear-dynamic-cast-target; }

    //--- media / brightness (verbatim port from keys.lua) ----------------
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay         allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev         allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext         allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "brightnessctl s 10%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl s 10%-"; }
}
